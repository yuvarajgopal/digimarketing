generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ──────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  name         String
  passwordHash String
  role         Role         @default(MANAGER)
  authProvider AuthProvider @default(LOCAL)
  cognitoSub   String?      @unique
  avatar       String?
  clientId           String?
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  client        Client?  @relation(fields: [clientId], references: [id])
  posts         Post[]
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]

  @@index([clientId])
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
  CLIENT
}

enum AuthProvider {
  LOCAL
  COGNITO
}

model Client {
  id        String       @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  website   String?
  industry  String?
  logo      String?
  notes     String?
  city      String?
  state     String?
  country   String?      // ISO 3166-1 alpha-2 code e.g. "US", "IN", "GB"
  aiProfile Json?        // { brandVoice, guidelines, targetAudience, competitors, forbiddenWords, samplePosts }
  businessAccountType BusinessAccountType @default(AGENCY_MANAGED)
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  platformConnections  PlatformConnection[]
  platformCredentials  ClientPlatformCredential[]
  posts                Post[]
  campaigns            Campaign[]
  analyticsSnapshots   AnalyticsSnapshot[]
  leads                Lead[]
  billingRecords       BillingRecord[]
  clientSubscriptions  ClientSubscription[]
  reports              Report[]
  tags                 ClientTag[]
  users                User[]
  assets               Asset[]
  templates            Template[]
  webTrafficSnapshots  WebTrafficSnapshot[]
  audienceSnapshots    AudienceSnapshot[]
  customAudiences      CustomAudience[]
  metaPixels           MetaPixel[]
  platformConfig       ClientPlatformConfig?
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum BusinessAccountType {
  CLIENT_MANAGED
  AGENCY_MANAGED
}

model AgencyConnection {
  id              String           @id @default(cuid())
  platform        Platform
  accessToken     String           // Encrypted - agency's API token
  refreshToken    String?          // Encrypted
  clientSecret    String?          // Encrypted - OAuth client secret (for token refresh)
  tokenExpiresAt  DateTime?
  accountName     String?          // e.g. "Our Facebook Business"
  appId           String?          // Platform app/client ID
  status          ConnectionStatus @default(ACTIVE)
  lastHealthCheck DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientConnections PlatformConnection[]

  @@unique([platform])
}

model PlatformConnection {
  id                 String           @id @default(cuid())
  clientId           String
  platform           Platform
  accessToken        String?          // Optional when using agency credentials
  refreshToken       String?
  tokenExpiresAt     DateTime?
  accountId          String?
  accountName        String?
  adAccountId        String?          // Meta Ad Account ID (act_xxx) — overrides META_AD_ACCOUNT_ID env var
  scopes             String[]
  status             ConnectionStatus @default(ACTIVE)
  lastHealthCheck    DateTime?
  agencyConnectionId String?
  clientCredentialId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  client           Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agencyConnection AgencyConnection?         @relation(fields: [agencyConnectionId], references: [id])
  clientCredential ClientPlatformCredential? @relation(fields: [clientCredentialId], references: [id])

  @@unique([clientId, platform, accountId])
  @@index([clientId])
}

model ClientPlatformCredential {
  id              String           @id @default(cuid())
  clientId        String
  platform        Platform
  useAgency       Boolean          @default(false)  // true = use agency credentials
  accessToken     String?          // Encrypted — null when useAgency
  refreshToken    String?          // Encrypted
  tokenExpiresAt  DateTime?
  accountName     String?          // e.g. "Client's Facebook Business"
  appId           String?          // Platform app/client ID
  adAccountId     String?          // Meta Ad Account ID (act_xxx) — per-client override
  status          ConnectionStatus @default(ACTIVE)
  lastHealthCheck DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientConnections PlatformConnection[]

  @@unique([clientId, platform])
  @@index([clientId])
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  GOOGLE_ADS
  YOUTUBE
  LINKEDIN
  TWITTER
  TIKTOK
  PINTEREST
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

model Post {
  id          String     @id @default(cuid())
  clientId    String
  createdById String
  content     String
  platforms     Platform[]
  connectionIds String[]
  status        PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  templateId  String?
  approvedBy  String?
  approvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  template  Template?     @relation(fields: [templateId], references: [id])
  media     PostMedia[]
  tags      PostTag[]
  metrics   PostMetrics[]

  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  assetId String
  order   Int    @default(0)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([postId])
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Int?
  folder       String?
  clientId     String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client    Client?     @relation(fields: [clientId], references: [id])
  postMedia PostMedia[]
  tags      AssetTag[]

  @@index([clientId])
}

enum AssetType {
  IMAGE
  VIDEO
  GIF
  DOCUMENT
}

model Template {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        TemplateType
  content     String
  platforms   Platform[]
  thumbnail   String?
  clientId    String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client Client?       @relation(fields: [clientId], references: [id])
  posts  Post[]
  tags   TemplateTag[]

  @@index([clientId])
}

enum TemplateType {
  POST
  CAMPAIGN
  REPORT
}

model Campaign {
  id                 String         @id @default(cuid())
  clientId           String
  name               String
  platform           Platform
  platformCampaignId String?
  objective          String?
  status             CampaignStatus @default(DRAFT)
  budget             Decimal?       @db.Decimal(12, 2)
  budgetType         BudgetType?
  startDate          DateTime?
  endDate            DateTime?
  targeting          Json?
  creatives          Json?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client  Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics CampaignMetrics[]

  @@index([clientId])
  @@index([platform])
}

enum CampaignStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum BudgetType {
  DAILY
  LIFETIME
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  clientId    String
  platform    Platform
  date        DateTime @db.Date
  metrics     Json
  dimension   String?
  dimensionId String?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform, date, dimension, dimensionId])
  @@index([clientId, date])
  @@index([platform])
}

model Lead {
  id         String     @id @default(cuid())
  clientId   String
  source     Platform?
  campaignId String?
  name       String?
  email      String?
  phone      String?
  company    String?
  status     LeadStatus @default(NEW)
  score      Int?
  data       Json?
  capturedAt DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model BillingRecord {
  id          String        @id @default(cuid())
  clientId    String
  type        BillingType
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  description String?
  period      String?
  status      BillingStatus @default(PENDING)
  invoiceUrl  String?
  paidAt      DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([clientId])
}

enum BillingType {
  RETAINER
  AD_SPEND
  ONE_TIME
  COMMISSION
}

enum BillingStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
  CANCELLED
}

// ─── Payment Gateway Models ──────────────────────────────────────

enum PaymentGateway {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
  TRIALING
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

model Payment {
  id                    String         @id @default(cuid())
  billingRecordId       String
  gateway               PaymentGateway
  status                PaymentStatus  @default(PENDING)
  amount                Decimal        @db.Decimal(12, 2)
  currency              String         @default("USD")
  stripePaymentIntentId String?
  stripeSessionId       String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  gatewayResponse       Json?
  failureReason         String?
  idempotencyKey        String         @unique
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)

  @@index([billingRecordId])
  @@index([stripeSessionId])
  @@index([razorpayOrderId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(INCOMPLETE)
  gateway                PaymentGateway
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  razorpaySubscriptionId String?
  amount                 Decimal            @db.Decimal(12, 2)
  currency               String             @default("USD")
  interval               String             @default("monthly")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([razorpaySubscriptionId])
}

model ClientSubscription {
  id                     String             @id @default(cuid())
  clientId               String
  name                   String             // e.g. "Monthly Retainer", "Ad Management Fee"
  amount                 Decimal            @db.Decimal(12, 2)
  currency               String             @default("USD")
  interval               String             @default("monthly") // monthly, yearly
  gateway                PaymentGateway
  status                 SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  razorpaySubscriptionId String?
  razorpayPlanId         String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([stripeSubscriptionId])
}

model Report {
  id       String     @id @default(cuid())
  clientId String
  type     ReportType
  title    String
  dateFrom DateTime
  dateTo   DateTime
  data      Json
  narrative String?  @db.Text  // AI-generated executive summary
  fileUrl   String?
  sentAt    DateTime?
  sentTo   String[]
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum ReportType {
  WEEKLY_PERFORMANCE
  MONTHLY_PERFORMANCE
  SOCIAL_MEDIA
  AD_CAMPAIGN
  LEAD_GENERATION
  WEBSITE_ANALYTICS
  EXECUTIVE_SUMMARY
  CUSTOM
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Client Analytics Models ──────────────────────────────────────

model PostMetrics {
  id             String   @id @default(cuid())
  postId         String
  platform       Platform
  impressions    Int      @default(0)
  reach          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  saves          Int      @default(0)
  videoViews     Int      @default(0)
  engagementRate Float    @default(0)
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
}

model CampaignMetrics {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  conversions Int      @default(0)
  cpc         Decimal  @default(0) @db.Decimal(12, 4)
  cpm         Decimal  @default(0) @db.Decimal(12, 4)
  cpa         Decimal  @default(0) @db.Decimal(12, 4)
  roas        Float    @default(0)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

model WebTrafficSnapshot {
  id                 String   @id @default(cuid())
  clientId           String
  date               DateTime @db.Date
  visits             Int      @default(0)
  uniqueVisitors     Int      @default(0)
  pageViews          Int      @default(0)
  bounceRate         Float    @default(0)
  avgSessionDuration Float    @default(0)
  topReferrer        String?
  referralBreakdown  Json?
  createdAt          DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId, date])
}

model AudienceSnapshot {
  id           String   @id @default(cuid())
  clientId     String
  platform     Platform
  date         DateTime @db.Date
  followers    Int      @default(0)
  following    Int      @default(0)
  newFollowers Int      @default(0)
  demographics Json?
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform, date])
  @@index([clientId, date])
  @@index([platform])
}

// ─── Audience & Pixel Models ─────────────────────────────────────

enum AudienceType {
  CUSTOMER_LIST
  WEBSITE
  LOOKALIKE
}

enum AudienceStatus {
  PENDING
  READY
  TOO_SMALL
  ERROR
}

model CustomAudience {
  id                 String         @id @default(cuid())
  clientId           String
  name               String
  type               AudienceType
  platformAudienceId String?
  sourceAudienceId   String?        // For lookalikes — references another CustomAudience.id
  status             AudienceStatus @default(PENDING)
  size               Int?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceAudience  CustomAudience? @relation("LookalikeSource", fields: [sourceAudienceId], references: [id])
  lookalikes      CustomAudience[] @relation("LookalikeSource")

  @@index([clientId])
}

model MetaPixel {
  id              String   @id @default(cuid())
  clientId        String
  platformPixelId String
  name            String
  status          String   @default("ACTIVE")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platformPixelId])
  @@index([clientId])
}

// ─── Tag Junction Tables ──────────────────────────────────────────

model ClientTag {
  clientId String
  tag      String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, tag])
}

model PostTag {
  postId String
  tag    String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
}

model AssetTag {
  assetId String
  tag     String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, tag])
}

model TemplateTag {
  templateId String
  tag        String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, tag])
}

/// Per-client ad platform configuration
model ClientPlatformConfig {
  id               String   @id @default(cuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Which platforms are enabled for this client (Platform enum values)
  enabledPlatforms String[]

  // ─── Meta ───────────────────────────────────────────────────
  metaAdAccountId  String?  /// Override ad account ID, e.g. "act_123456789"
  metaPageId       String?  /// Facebook Page ID

  // ─── Google Ads ─────────────────────────────────────────────
  googleCustomerId  String?  /// Customer ID without dashes, e.g. "1234567890"
  googleManagerId   String?  /// MCC/Manager account ID (optional)
  googleBidStrategy String?  @default("MAXIMIZE_CLICKS")
  googleTargetCpa   Decimal?
  googleTargetRoas  Decimal?

  // ─── LinkedIn ────────────────────────────────────────────────
  linkedinAdAccountId    String?  /// Campaign Manager Account ID (from URL: /campaignmanager/accounts/{id}/)
  linkedinOrganizationId String?  /// Company Page Organization ID (numeric, used in URN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton agency profile — first (and only) row is the agency's settings
model AgencyProfile {
  id           String   @id @default(cuid())
  name         String   @default("DigiCampaign Agency")
  website      String?
  supportEmail String?
  country      String?  /// ISO 3166-1 alpha-2, e.g. "IN", "US"
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
